GitHub Action Script
name: Deploy Application

on:
  push:
    branches:
      - main

jobs:

  build:

    runs-on: ubuntu-latest

    steps:

    - name: Checkout Code
      uses: actions/checkout@v3

    - name: Login Docker Hub
      uses: docker/login-action@v2
      with:
        username: ${{ secrets.DOCKER_USERNAME }}
        password: ${{ secrets.DOCKER_PASSWORD }}

    - name: Build Backend Image
      run: |
        docker build -t ${{ secrets.DOCKER_USERNAME }}/vanda-backend ./backend

    - name: Build Frontend Image
      run: |
        docker build -t ${{ secrets.DOCKER_USERNAME }}/vanda-frontend ./frontend

    - name: Push Images
      run: |
        docker push ${{ secrets.DOCKER_USERNAME }}/vanda-backend
        docker push ${{ secrets.DOCKER_USERNAME }}/vanda-frontend

    - name: Deploy to Server
      uses: appleboy/ssh-action@v0.1.6
      with:
        host: ${{ secrets.SERVER_IP }}
        username: ${{ secrets.SERVER_USER }}
        key: ${{ secrets.SSH_PRIVATE_KEY }}
        script: |
          docker pull ${{ secrets.DOCKER_USERNAME }}/vanda-backend
          docker pull ${{ secrets.DOCKER_USERNAME }}/vanda-frontend

          docker stop laravel_backend || true
          docker stop vue_frontend || true

          docker rm laravel_backend || true
          docker rm vue_frontend || true

          docker run -d -p 9000:9000 --name laravel_backend ${{ secrets.DOCKER_USERNAME }}/vanda-backend
          docker run -d -p 5173:5173 --name vue_frontend ${{ secrets.DOCKER_USERNAME }}/vanda-frontend